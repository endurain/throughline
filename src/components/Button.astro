---
interface Props {
  href: string;
  variant?: 'primary' | 'navy' | 'secondary' | 'ghost-light';
  size?: 'sm' | 'md';
}

const { href, variant = 'primary', size = 'md' } = Astro.props;
---

<a href={href} class:list={['btn', variant, size]}><slot /></a>

<style lang="scss">
  .btn {
    display: inline-flex;
    align-items: center;
    gap: $space-2;
    font-family: $font-sans;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    text-decoration: none;
    border-radius: $radius;
    border: 1px solid transparent;
    padding: 14px 20px;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
    white-space: nowrap;
  }

  .sm {
    padding: 10px 14px;
    font-size: 0.875rem;
  }

  .primary {
    background: $orange;
    color: #fff;
    &:hover {
      background: $orange-hover;
    }
  }

  .navy {
    background: $navy;
    color: $on-navy;
    &:hover {
      background: $navy-deep;
    }
  }

  .secondary {
    background: transparent;
    color: $ink;
    border-color: $gray-400;
    &:hover {
      border-color: $ink;
    }
  }

  .ghost-light {
    background: transparent;
    color: $on-navy;
    border-color: rgba($on-navy, 0.35);
    &:hover {
      border-color: $on-navy;
    }
  }
</style>
