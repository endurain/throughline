---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'labs'>;
}

const { post } = Astro.props;
const { title, description, date, tags, heroImage } = post.data;
---

<article class="post">
  <a href={`/labs/${post.id}`} class="wrap">
    {heroImage && <img src={heroImage} alt="" loading="lazy" />}
    <div class="meta mono">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags[0] && <span class="tag">{tags[0]}</span>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
  </a>
</article>

<style lang="scss">
  .post {
    border-top: $border;
  }

  .wrap {
    display: block;
    padding: $space-5 0;
    text-decoration: none;

    &:hover h3 {
      box-shadow: inset 0 -2px 0 $orange;
    }
  }

  img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    margin-bottom: $space-4;
    border: $border;
  }

  .meta {
    display: flex;
    gap: $space-3;
    font-size: 0.8125rem;
    color: $gray-600;
    margin-bottom: $space-2;
  }

  .tag {
    color: $orange;
  }

  h3 {
    display: inline;
    font-size: 1.375rem;
  }

  p {
    color: $gray-700;
    margin: $space-2 0 0;
    max-width: 64ch;
  }
</style>
